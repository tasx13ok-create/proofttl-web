{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=()" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    { "source": "/workspace", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/workspace/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/login", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/login/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/two-factor", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/two-factor/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/onboarding", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/onboarding/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/console", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/console/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/account", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/account/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ],
  "routes": [
    { "src": "^/google057072aa15e009ed\\.html$", "dest": "/api/google-site-verification" },
    { "src": "^/(studio|work|files|automations|money|connections|worlds|cinematics)(?:/.*)?$", "status": 308, "headers": { "Location": "/audit/" } },
    { "src": "^/(reality-engine|edon-bootstrap|edon-live)(?:/.*)?$", "status": 308, "headers": { "Location": "/audit/" } },
    { "src": "^/cinematics-runtime\\.js$", "status": 308, "headers": { "Location": "/audit/" } },
    { "src": "^/preflight/?$", "status": 308, "headers": { "Location": "/stress-test/" } },
    { "src": "^/api/auth/(?<authpath>.*)$", "dest": "/api/auth-proxy.js?path=$authpath" },
    { "src": "^/api/runtime/(?<runtimepath>.*)$", "dest": "/api/runtime-proxy.js?path=$runtimepath" },
    { "src": "^/trust\\.html$", "status": 308, "headers": { "Location": "/trust/" } },
    { "src": "^/lease-ops\\.html$", "status": 308, "headers": { "Location": "/lease-ops/" } },
    { "src": "^/status\\.html$", "status": 308, "headers": { "Location": "/status/" } },
    { "src": "^/methodology\\.html$", "status": 308, "headers": { "Location": "/how-proofttl-works/" } }
  ]
}
